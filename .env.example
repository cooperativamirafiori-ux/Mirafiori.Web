# ============================================================
# CONFIGURAZIONE NECESSARIA — copiare in .env.local
# ============================================================

# --- NextAuth ---
# Genera con: openssl rand -base64 32
AUTH_SECRET=genera-un-secret-casuale

# --- Microsoft Entra ID (App Registration) ---
# Pannello: https://portal.azure.com → Entra ID → App registrations
# Tipo: Web application
# Redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=<Application (client) ID>
AUTH_MICROSOFT_ENTRA_ID_SECRET=<Client Secret value>
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=9758581d-e1a8-4a08-90c9-d2f5e3b16ea5

# --- Graph API (permessi app — per operazioni server-side) ---
# Stessa App Registration, sezione "API permissions":
#   Sites.ReadWrite.All (Application) — per SharePoint Lists
#   Mail.Send (Application) — per email
# Usa il "client credentials flow" (non delegato) per le API routes
GRAPH_TENANT_ID=9758581d-e1a8-4a08-90c9-d2f5e3b16ea5
GRAPH_CLIENT_ID=<Application (client) ID> # stesso di sopra
GRAPH_CLIENT_SECRET=<Client Secret value>  # stesso di sopra

# --- SharePoint ---
SHAREPOINT_SITE_URL=https://coopmirafiorionlus.sharepoint.com/sites/gruppo_ControlloGestione
# Site ID Graph: ottenibile con GET https://graph.microsoft.com/v1.0/sites/coopmirafiorionlus.sharepoint.com:/sites/gruppo_ControlloGestione
SHAREPOINT_SITE_ID=<site-id da Graph>

# --- SharePoint List GUIDs (già noti dalla Power App) ---
SP_LIST_STRUTTURE=601bd80b-82bc-4f49-90ae-e31e6190dc09
SP_LIST_TECNICI=e8645aed-70bb-481d-981f-e1e166fd8b16
SP_LIST_RICHIESTE=e6261996-1a0e-4042-9afb-5ec729924763
SP_LIST_COSTI=48b5e834-df39-4bc2-bb2c-9380b414b8cd
SP_LIST_PARAMETRI=d956ec55-998c-4b95-80b6-2f3d193f351e
# Lista admin (da creare su SharePoint — vedi README)
SP_LIST_ADMIN=<guid lista Admin Manutenzioni>
# Lista permessi per area (colonne: Utente [Person], Area [Choice/Testo])
SP_LIST_AUTORIZZAZIONI=<guid lista Autorizzazioni>

# --- Prestazioni Occasionali (vedi docs/prestazioni-setup-sharepoint.md) ---
SP_LIST_PRESTAZIONI=<guid lista Prestazioni Occasionali>
# Cartella radice nella document library (opzionale, default: "Prestazioni Occasionali")
SP_PRESTAZIONI_FOLDER_PATH=Prestazioni Occasionali
# Drive/libreria documentale (opzionale: se assente usa il drive predefinito del sito)
# SP_PRESTAZIONI_DRIVE_ID=<guid drive>
# Destinatari mail di riepilogo (opzionale: default info@ + Claudia)
# PRESTAZIONI_MAIL_TO=info@cooperativamirafiori.com,claudia.carena@cooperativamirafiori.com
# URL pubblico dell'app (per il link "Carica notula" nella mail al prestatore)
APP_BASE_URL=https://mirafiori-web.vercel.app
# Segreto per il cron promemoria foglio ore (Vercel allega Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=genera-un-secret-casuale

# --- Richieste Acquisto ---
# Lista creata da: node scripts/provision-acquisti.mjs
# Lo script estende anche le Choice di Costi Strutture con "Acquisti"/"Acquisto",
# necessarie perché la spesa di un acquisto consegnato entri nel cruscotto costi.
SP_LIST_ACQUISTI=<guid lista Richieste Acquisto>
# Destinatari del digest giornaliero delle nuove richieste (opzionale).
# I gestori — chi ha il permesso d'area "Acquisti" — sono sempre inclusi.
# ACQUISTI_MAIL_TO=ufficio.rendicontazione@cooperativamirafiori.com
#
# Consegna presidiata: per questa struttura la mail "e' arrivato?" va ai referenti
# dell'ufficio invece che al richiedente, e alla loro conferma il richiedente
# riceve l'avviso che puo' passare a ritirare. I default sono Strada del Drosso
# con Stefano Martino ed Eleonora Dessi: bastano queste righe per cambiarli.
# ACQUISTI_PRESIDIO_STRUTTURA=Strada del Drosso
# ACQUISTI_PRESIDIO_REFERENTI=stefano.martino@cooperativamirafiori.com,eleonora.dessi@cooperativamirafiori.com
# ACQUISTI_PRESIDIO_RITIRO=Ufficio in Strada del Drosso

# --- Inventario Beni ---
# Lista e cartella create da: node scripts/provision-inventario.mjs
SP_LIST_INVENTARIO=<guid lista Inventario Beni>
SP_INVENTARIO_DRIVE_ID=<guid drive della libreria che contiene le cartelle>
# Cartella radice dentro quel drive. "." significa la radice della libreria.
SP_INVENTARIO_FOLDER=Inventario Beni

# --- Assistenza IT ---
# Lista creata da: node scripts/provision-assistenza.mjs
SP_LIST_ASSISTENZA=<guid lista Assistenza IT>
# Casella dell'ufficio in copia al digest (opzionale: senza, va ai soli gestori dell'area IT)
# ASSISTENZA_MAIL_TO=
# Dove finiscono gli allegati dei ticket (opzionali: senza, drive predefinito del sito)
# SP_ASSISTENZA_DRIVE_ID=<guid drive>
# SP_ASSISTENZA_FOLDER=Allegati Assistenza

# --- Gestione Software (Amministrazione) ---
# Lista creata da: node scripts/provision-software.mjs
SP_LIST_SOFTWARE=<guid lista Gestione Software>
# Drive/libreria per le fatture (opzionale: se assente usa il drive predefinito del sito)
# SP_SOFTWARE_DRIVE_ID=<guid drive>
# Gli alert di scadenza sono eventi scritti nei calendari Outlook scelti nel form.
# Richiede il permesso app Calendars.ReadWrite (Application) concesso in Azure.

# --- Risorse Umane ---
# Liste create da: node scripts/provision-risorse-umane.mjs
SP_LIST_DIPENDENTI=<guid lista Dipendenti>
SP_LIST_TIROCINI=<guid lista Tirocini>
# --- Log Attività (audit applicativo — vedi docs/log-attivita-setup-sharepoint.md) ---
# Se assente, il logging è disattivato (no-op): l'app funziona comunque.
SP_LIST_LOG=<guid lista Log Attività>
# Cartella radice per le cartelle personali dei dipendenti (opzionale, default: "Risorse Umane/Dipendenti")
# SP_RU_FOLDER=Risorse Umane/Dipendenti
# Drive/libreria documentale (opzionale: se assente usa il drive predefinito del sito)
# SP_RU_DRIVE_ID=<guid drive>

# --- DocuSign (JWT / Service Integration) — vedi docs/docusign-setup.md ---
DOCUSIGN_OAUTH_HOST=account-d.docusign.com           # demo; prod: account.docusign.com
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi # prod: https://<regione>.docusign.net/restapi
DOCUSIGN_INTEGRATION_KEY=<Integration Key / client id>
DOCUSIGN_USER_ID=<User ID GUID utente impersonato>
DOCUSIGN_ACCOUNT_ID=<API Account ID GUID>
DOCUSIGN_PRIVATE_KEY_BASE64=<chiave privata RSA (PEM) in base64>

# --- Email (mittenti — caselle esistenti in Exchange) ---
# Acquisti + manutenzioni (e destinatario avvisi admin manutenzioni)
MAIL_SENDER_EMAIL=ufficio.rendicontazione@cooperativamirafiori.com
# Timbrature — solleciti foglio ore
# TIMBRATURE_MAIL_FROM=risorseumane@cooperativamirafiori.com

# --- Timbrature (Supabase / Postgres) ---
# Progetto Supabase → Settings → API. La service role key è SEGRETA: solo server.
# Schema e seed: eseguire web/supabase/timbrature_schema.sql nel SQL editor.
# Permessi per area (lista Autorizzazioni): "Timbrature" per gli operatori,
# "Risorse Umane" per il cruscotto HR e la chiusura mese.
SUPABASE_URL=<https://xxxxxxxx.supabase.co>
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# --- URL app (per redirect) ---
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Area Risorse Umane su sito SharePoint dedicato con accesso delegato
# (docs/piano-ru-sito-dedicato-accesso-delegato.md)
#
# Blocco tutto-o-nulla: la presenza di SP_SITE_RU sposta l'area RU sul sito
# dedicato E sull'identità dell'utente. Le liste sul sito nuovo hanno GUID
# diversi, quindi SP_LIST_DIPENDENTI/SP_LIST_TIROCINI vanno cambiati insieme.
# ---------------------------------------------------------------------------
SP_SITE_RU=<site id del sito Risorse Umane — node scripts/get-site-id.mjs <url>>
SP_RU_DRIVE_ID=<drive id della raccolta documenti del sito RU>
SP_RU_FOLDER=Risorse Umane App/Dipendenti

# Object id del gruppo Microsoft 365 del sito RU. È la fonte di verità su chi
# accede alle anagrafiche del personale (lib/gruppo-ru.ts): non c'è un permesso
# applicativo per quest'area. Richiede GroupMember.Read.All (Application).
SP_GRUPPO_RU_ID=<object id del gruppo M365 "Risorse Umane">

# Chiave AES-256 per cifrare i token delegati in tabella ms_token (Supabase).
# Generala con:  openssl rand -base64 32
# ⚠️ Se la cambi, i token già memorizzati diventano illeggibili e tutti gli
# utenti dell'area RU devono rifare l'accesso (errore gestito, non un crash).
TOKEN_ENC_KEY=<32 byte in base64>

# --- CDA → Planner (solo locale: lo script non gira su Vercel) ---
# Object id del gruppo M365 "CDA" e id del piano Planner dove finiscono i task
# decisi in consiglio (piano "CDA 2026" nel team CDA).
# Richiede Tasks.ReadWrite.All (Application) con consenso admin.
# Se il piano cambia (es. "CDA 2027") basta sostituire PLANNER_PLAN_CDA; l'id si
# legge dall'URL di Planner oppure con:
#   node scripts/verbale-a-planner.mjs --piani
# Vedi docs/cda-planner.md
PLANNER_GROUP_CDA=67e88d0c-ef5c-4a5c-aa88-0f786567555f
PLANNER_PLAN_CDA=jzZ7_gFSrkCz75IjO2BnYZgAF0FS
