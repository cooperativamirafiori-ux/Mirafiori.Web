# ============================================================
# CONFIGURAZIONE NECESSARIA — copiare in .env.local
# ============================================================

# --- NextAuth ---
# Genera con: openssl rand -base64 32
AUTH_SECRET=genera-un-secret-casuale

# --- Microsoft Entra ID (App Registration) ---
# Pannello: https://portal.azure.com → Entra ID → App registrations
# Tipo: Web application
# Redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=<Application (client) ID>
AUTH_MICROSOFT_ENTRA_ID_SECRET=<Client Secret value>
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=9758581d-e1a8-4a08-90c9-d2f5e3b16ea5

# --- Graph API (permessi app — per operazioni server-side) ---
# Stessa App Registration, sezione "API permissions":
#   Sites.ReadWrite.All (Application) — per SharePoint Lists
#   Mail.Send (Application) — per email
# Usa il "client credentials flow" (non delegato) per le API routes
GRAPH_TENANT_ID=9758581d-e1a8-4a08-90c9-d2f5e3b16ea5
GRAPH_CLIENT_ID=<Application (client) ID> # stesso di sopra
GRAPH_CLIENT_SECRET=<Client Secret value>  # stesso di sopra

# --- SharePoint ---
SHAREPOINT_SITE_URL=https://coopmirafiorionlus.sharepoint.com/sites/gruppo_ControlloGestione
# Site ID Graph: ottenibile con GET https://graph.microsoft.com/v1.0/sites/coopmirafiorionlus.sharepoint.com:/sites/gruppo_ControlloGestione
SHAREPOINT_SITE_ID=<site-id da Graph>

# --- SharePoint List GUIDs (già noti dalla Power App) ---
SP_LIST_STRUTTURE=601bd80b-82bc-4f49-90ae-e31e6190dc09
SP_LIST_TECNICI=e8645aed-70bb-481d-981f-e1e166fd8b16
SP_LIST_RICHIESTE=e6261996-1a0e-4042-9afb-5ec729924763
SP_LIST_COSTI=48b5e834-df39-4bc2-bb2c-9380b414b8cd
SP_LIST_PARAMETRI=d956ec55-998c-4b95-80b6-2f3d193f351e
# Lista admin (da creare su SharePoint — vedi README)
SP_LIST_ADMIN=<guid lista Admin Manutenzioni>

# --- Email (mittente notifiche — deve avere licenza Exchange) ---
MAIL_SENDER_EMAIL=<email mittente con licenza Exchange>

# --- URL app (per redirect) ---
NEXTAUTH_URL=http://localhost:3000
